{
  // Worker cron RIÊNG (không dính Pages crm-doscom) — chạy đúng giờ trên Cloudflare,
  // gọi GitHub workflow_dispatch của refresh-data.yml (thay GitHub schedule hay bị trễ).
  "name": "doscom-cron",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "triggers": {
    // Giờ UTC (VN = UTC+7). Chủ dự án chốt 22/08/2026: dashboard cập nhật
    // 2 lần/ngày — 09:00 và 15:00 giờ VN — T2 đến T7, CHỦ NHẬT NGHỈ (`1-6`).
    //   02:00 UTC = 09:00 VN   ·   08:00 UTC = 15:00 VN
    // Mốc này chạy SAU các workflow kéo dữ liệu (07:00–08:00 và 13:00–14:00 VN)
    // nên dashboard luôn dựng từ dữ liệu vừa kéo về.
    "crons": ["0 2 * * 1-6", "0 8 * * 1-6"]
  },
  // Bù đơn Thái chưa lên Sheet (mốc 9h) cần đọc/ghi bảng landing_leads.
  "d1_databases": [
    { "binding": "DB", "database_name": "crm-doscom-db",
      "database_id": "73cfb6ca-b9b4-4a9b-b74f-1a030f8db1d0" }
  ],
  // Dùng CHUNG namespace với Pages crm-doscom để banner cảnh báo đọc được cùng một key.
  "kv_namespaces": [
    { "binding": "INVENTORY", "id": "3efb5b02ea844d67ade8d070547ae707" }
  ],
  // Secret (wrangler secret put --name doscom-cron):
  //   TH_SHEET_URL — URL /exec của Apps Script "Webhook D1 Thái Lan".
  //   ⚠ Chủ dự án hay bấm "New deployment" thay vì "New version" -> URL ĐỔI.
  //      Đổi URL thì phải set lại secret này, KHÔNG thì mỗi sáng bù đơn đều thất bại.
  "observability": { "enabled": true }
}
